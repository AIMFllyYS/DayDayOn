# 环境变量清单。复制为 .env.local（本地）或服务器 .env 后填写真实值。
# 真实值不要提交，也不要发到聊天里。标"规划"的变量在对应功能接入时才会用到。

# ---------- 应用 ----------
# 站点对外地址（构建时写入客户端）
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 部署时由 workflow 写入，健康检查会返回它
APP_COMMIT_SHA=

# ---------- 数据库（规划） ----------
# 本地 Docker PG；服务器上为 127.0.0.1:55438
DATABASE_URL=postgres://daydayon:change-me@127.0.0.1:55432/daydayon

# ---------- 认证（规划，Better Auth） ----------
# 至少 32 字节的随机串：openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------- 邮件：阿里云邮件推送 SMTP（规划） ----------
# 华东 1（杭州）。控制台选了其他区域就换成对应地址
SMTP_HOST=smtpdm.aliyun.com
# 465 = SSL。ECS 默认封禁 25 端口
SMTP_PORT=465
# 发信地址，同时也是 SMTP 用户名
SMTP_USER=
# 控制台为该发信地址设置的 SMTP 密码（不是阿里云账号密码）
SMTP_PASS=

# ---------- AI：DeepSeek（规划） ----------
DEEPSEEK_API_KEY=
# 只用 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
