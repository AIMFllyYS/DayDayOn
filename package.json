{
  "name": "daydayon",
  "version": "0.1.0",
  "private": true,
  "description": "DayDayOn —— 治愈系多人互动打卡应用（PWA，手机与电脑双端）",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "next dev -p 23329",
    "build": "next build",
    "start": "next start -p 23329",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "test": "vitest run",
    "db:up": "docker compose -f scripts/dev/docker-compose.db.yml up -d --wait",
    "db:down": "docker compose -f scripts/dev/docker-compose.db.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/dev/migrate.ts",
    "db:seed": "tsx scripts/dev/seed.ts",
    "openapi:export": "tsx scripts/dev/export-openapi.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.77",
    "@ai-sdk/react": "4.0.163",
    "@base-ui/react": "1.9.0",
    "@date-fns/tz": "1.5.0",
    "@hono/zod-openapi": "1.6.3",
    "@tanstack/react-query": "5.105.0",
    "ai": "7.0.159",
    "better-auth": "1.7.14",
    "d3-shape": "3.2.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
